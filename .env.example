# Database (PostgreSQL via docker-compose recommended)
DATABASE_URL="postgresql://paperlab:paperlab@localhost:5432/paperlab?schema=public"

# Server
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Deterministic simulation seed
SEED=20261001

# Paper trading bankroll (fictitious money only)
INITIAL_BANKROLL=2000
STAKE_PERCENTAGE=0.02
COMMISSION=0.005
TARGET_PROFIT=0.05
# Favorite first-leg band for live surebet (e.g. 1.60–1.80)
MIN_ODDS=1.60
MAX_ODDS=1.80
EXECUTION_DELAY_MS=500
MAX_SLIPPAGE=0.01
EXECUTION_PROBABILITY=0.98
ALLOW_PARTIAL_FILLS=true
LIVE_ONLY=true

# Data quality
STALE_DATA_MS=15000
MIN_LIQUIDITY=10

# Sports filter (comma-separated). Empty = all from /sports metadata
ENABLED_SPORTS=soccer,football,nba,nfl,mlb,nhl,tennis,basketball,hockey,baseball

# Market data mode: live | mock
MARKET_DATA_MODE=live

# Frontend (leave empty in production — same origin)
VITE_API_URL=
VITE_WS_URL=

# REAL EXECUTION — ALWAYS DISABLED. Do not enable.
REAL_EXECUTION_ENABLED=false
